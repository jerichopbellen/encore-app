# Local development database. For Neon runtime traffic, use its pooled URL with sslmode=require.
DATABASE_URL="postgresql://encore_user:replace-with-url-encoded-password@localhost:5432/encore?schema=public"

# Optional Prisma CLI connection. Set this to the direct URL for hosted migrations and tooling.
# If blank, Prisma CLI falls back to DATABASE_URL.
DIRECT_DATABASE_URL=

# Optional, dedicated database used only by `npm run test:integration`.
# Its database name must include "test", for example encore_test.
TEST_DATABASE_URL="postgresql://encore_user:replace-with-url-encoded-password@localhost:5432/encore_test?schema=public"

JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

JWT_EXPIRES_IN=1d

# Exact browser frontend origin used by CORS and unsafe API Origin checks.
# Production requires an HTTPS origin, for example https://encore.example.com.
FRONTEND_ORIGIN=http://localhost:5173

# lax is recommended when the UI and API use custom domains under the same site.
# Use none only for cross-site HTTPS cookies; some browsers block third-party cookies.
COOKIE_SAME_SITE=lax

NODE_ENV=development

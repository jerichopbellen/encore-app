# Local development database. For Neon runtime traffic, use its pooled URL with sslmode=require.
DATABASE_URL="postgresql://encore_user:replace-with-url-encoded-password@localhost:5432/encore?schema=public"

# Optional Prisma CLI connection. Set this to the direct URL for hosted migrations and tooling.
# If blank, Prisma CLI falls back to DATABASE_URL.
DIRECT_DATABASE_URL=

# Optional, dedicated database used only by `npm run test:integration`.
# Its database name must include "test", for example encore_test.
TEST_DATABASE_URL="postgresql://encore_user:replace-with-url-encoded-password@localhost:5432/encore_test?schema=public"

JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

JWT_EXPIRES_IN=1d

# Exact browser frontend origin used by CORS and unsafe API Origin checks.
# Production requires an HTTPS origin, for example https://encore.example.com.
FRONTEND_ORIGIN=http://localhost:5173

# lax is recommended when the UI and API use custom domains under the same site.
# Use none only for cross-site HTTPS cookies; some browsers block third-party cookies.
COOKIE_SAME_SITE=lax

NODE_ENV=development

# Payment mode. "simulated" (default) keeps the no-charge simulated checkout.
# "stripe" requires Stripe-hosted Checkout in TEST mode; simulated checkout is then rejected by the API.
PAYMENT_PROVIDER=simulated

# Required only when PAYMENT_PROVIDER=stripe. Only test-mode keys (sk_test_...) are accepted.
# STRIPE_WEBHOOK_SECRET comes from the Stripe CLI (`stripe listen`) or the dashboard webhook endpoint
# for POST /api/payments/stripe/webhook (events: checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional admin event poster uploads (Cloudinary). Leave all three blank to disable uploads;
# every event then keeps Encore's generated default poster. Set all three together or startup fails.
# Values come from the Cloudinary console (Settings > API Keys). They are server-only secrets:
# never copy them into client/.env or any VITE_ variable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional Cloudinary folder for poster assets: the Media Library folder and public ID prefix.
# Defaults to encore/event-posters.
# Use a different prefix per environment, for example encore-dev/event-posters locally.
CLOUDINARY_POSTER_FOLDER=
# Optional maximum poster size in bytes (1024 to 10485760). Defaults to 4194304 (4 MB).
POSTER_UPLOAD_MAX_BYTES=

# --- Express rate limiting (all optional; unset variables use the defaults shown) ---
# The IP-keyed limiters (LOGIN_IP, LOGIN_FAILURE, REGISTRATION, RESERVATION_IP, GENERAL_READ) run only when
# NODE_ENV is exactly "development" or "test". In production, or with an unset or unexpected NODE_ENV,
# they are off and the account-based limiters stay active. See DEPLOYMENT.md, "Express-level rate limiting".

# Number of trusted proxies in front of Express (a whole number from 1 to 5; 0 is rejected in production).
# LEAVE THIS UNSET IN PRODUCTION under the current Vercel-to-Render architecture: the two request paths
# have different proxy chains, no single value is safe for both, and the API ignores it there.
# It only has an effect in development and test.
# TRUST_PROXY_HOPS=

# Per-limiter overrides: RATE_LIMIT_<NAME>_MAX (1 to 100000) and RATE_LIMIT_<NAME>_WINDOW_MINUTES (1 to 1440).
# The values below are the defaults.
# IP-keyed: off in production
# RATE_LIMIT_LOGIN_IP_MAX=20
# RATE_LIMIT_LOGIN_IP_WINDOW_MINUTES=15
# email + IP: off in production
# RATE_LIMIT_LOGIN_FAILURE_MAX=5
# RATE_LIMIT_LOGIN_FAILURE_WINDOW_MINUTES=15
# email only: the production login-failure limiter while IP limiting is off
# RATE_LIMIT_LOGIN_FAILURE_NO_IP_MAX=50
# RATE_LIMIT_LOGIN_FAILURE_NO_IP_WINDOW_MINUTES=60
# IP-keyed: off in production
# RATE_LIMIT_REGISTRATION_MAX=5
# RATE_LIMIT_REGISTRATION_WINDOW_MINUTES=60
# per account
# RATE_LIMIT_RESERVATION_CREATION_MAX=10
# RATE_LIMIT_RESERVATION_CREATION_WINDOW_MINUTES=10
# per account
# RATE_LIMIT_RESERVATION_ATTEMPT_MAX=60
# RATE_LIMIT_RESERVATION_ATTEMPT_WINDOW_MINUTES=10
# IP-keyed: off in production
# RATE_LIMIT_RESERVATION_IP_MAX=30
# RATE_LIMIT_RESERVATION_IP_WINDOW_MINUTES=10
# per account
# RATE_LIMIT_RESERVATION_CANCEL_MAX=30
# RATE_LIMIT_RESERVATION_CANCEL_WINDOW_MINUTES=10
# per account
# RATE_LIMIT_RESERVATION_READ_MAX=200
# RATE_LIMIT_RESERVATION_READ_WINDOW_MINUTES=10
# per account
# RATE_LIMIT_PAYMENT_INITIATION_MAX=10
# RATE_LIMIT_PAYMENT_INITIATION_WINDOW_MINUTES=10
# per account
# RATE_LIMIT_PAYMENT_CANCELLATION_MAX=20
# RATE_LIMIT_PAYMENT_CANCELLATION_WINDOW_MINUTES=10
# per admin account
# RATE_LIMIT_POSTER_MUTATION_MAX=20
# RATE_LIMIT_POSTER_MUTATION_WINDOW_MINUTES=10
# IP-keyed: off in production
# RATE_LIMIT_GENERAL_READ_MAX=300
# RATE_LIMIT_GENERAL_READ_WINDOW_MINUTES=15

# Maximum counters each limiter keeps in memory (100 to 1000000). When a limiter is full of live counters,
# requests for a new key are refused with 429 until counters expire; live counters are never evicted.
# RATE_LIMIT_MAX_KEYS=10000

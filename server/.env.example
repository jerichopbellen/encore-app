DB_HOST=localhost
DB_PORT=5432
DB_NAME=encore
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DATABASE_URL="postgresql://your_postgres_user:your_postgres_password@localhost:5432/encore?schema=public"

# Replace this placeholder with a randomly generated secret of at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRES_IN=1d

# Browser origin used by the Vite development server / production frontend.
FRONTEND_ORIGIN=http://localhost:5173

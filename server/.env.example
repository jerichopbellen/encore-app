DATABASE_URL="postgresql://encore_user:replace-with-url-encoded-password@localhost:5432/encore?schema=public"

# Optional, dedicated database used only by `npm run test:integration`.
# Its database name must include "test", for example encore_test.
TEST_DATABASE_URL="postgresql://encore_user:replace-with-url-encoded-password@localhost:5432/encore_test?schema=public"

JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

JWT_EXPIRES_IN=1d

NODE_ENV=development

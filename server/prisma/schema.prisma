generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "mts"
  importFileExtension    = "mts"
  moduleFormat           = "esm"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bookings {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservation_id   String             @unique @db.Uuid
  user_id          String             @db.Uuid
  total_amount     Decimal            @db.Decimal(12, 2)
  status           String             @default("confirmed") @db.VarChar(20)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  reservations     reservations       @relation(fields: [reservation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_attempts payment_attempts[]

  // Lets payment_attempts reference a booking together with its own reservation.
  @@unique([id, reservation_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model events {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String         @db.VarChar(200)
  description  String?
  venue        String         @db.VarChar(200)
  starts_at    DateTime       @db.Timestamptz(6)
  status       String         @default("draft") @db.VarChar(20)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  // Optional admin-uploaded Cloudinary poster. Both columns are set or both are
  // null (events_poster_pair_check); null means the generated default poster.
  poster_public_id String?    @unique @db.VarChar(255)
  poster_url       String?
  ticket_types ticket_types[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// Durable list of Cloudinary poster assets that may need deleting. A row is written before an upload
/// (and removed by the transaction that attaches the asset) and whenever an event switches away from a
/// poster, so a failed or interrupted cleanup can be retried later.
model event_poster_cleanups {
  public_id  String   @id @db.VarChar(255)
  event_id   String   @db.Uuid
  reason     String   @db.VarChar(20)
  attempts   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
}

model idempotency_keys {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  operation       String   @db.VarChar(50)
  idempotency_key String   @db.VarChar(255)
  request_hash    String
  response_status Int?
  response_body   Json?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  users           users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, operation, idempotency_key])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reservation_items {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservation_id String       @db.Uuid
  ticket_type_id String       @db.Uuid
  quantity       Int
  unit_price     Decimal      @db.Decimal(12, 2)
  reservations   reservations @relation(fields: [reservation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket_types   ticket_types @relation(fields: [ticket_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([reservation_id, ticket_type_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reservations {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String              @db.Uuid
  status            String              @default("pending") @db.VarChar(20)
  expires_at        DateTime            @db.Timestamptz(6)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  bookings          bookings?
  payment_attempts  payment_attempts[]
  reservation_items reservation_items[]
  users             users               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ticket_types {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id           String              @db.Uuid
  name               String              @db.VarChar(100)
  price              Decimal             @db.Decimal(12, 2)
  total_quantity     Int
  available_quantity Int
  reservation_items  reservation_items[]
  events             events              @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([event_id, name])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @db.VarChar(100)
  email            String             @unique @db.VarChar(255)
  password_hash    String
  role             String             @default("customer") @db.VarChar(20)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  bookings         bookings[]
  idempotency_keys idempotency_keys[]
  payment_attempts payment_attempts[]
  reservations     reservations[]
}

/// This table contains check constraints and a partial unique index (payment_attempts_one_live_per_reservation_key, status IN ('creating','open')) that exist only in the migration SQL. Visit https://pris.ly/d/check-constraints for more info.
/// One row per attempt to pay for a reservation through Stripe-hosted Checkout.
model payment_attempts {
  id                         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservation_id             String       @db.Uuid
  user_id                    String       @db.Uuid
  provider                   String       @default("stripe") @db.VarChar(20)
  amount                     Decimal      @db.Decimal(12, 2)
  currency                   String       @default("PHP") @db.VarChar(3)
  status                     String       @default("creating") @db.VarChar(20)
  stripe_checkout_session_id String?      @unique @db.VarChar(255)
  stripe_payment_intent_id   String?      @db.VarChar(255)
  checkout_url               String?
  booking_id                 String?      @unique @db.Uuid
  review_reason              String?      @db.VarChar(40)
  session_expires_at         DateTime     @db.Timestamptz(6)
  checkout_items             Json         @default("[]")
  paid_at                    DateTime?    @db.Timestamptz(6)
  created_at                 DateTime     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime     @default(now()) @db.Timestamptz(6)
  bookings                   bookings?    @relation(fields: [booking_id, reservation_id], references: [id, reservation_id], onDelete: NoAction, onUpdate: NoAction)
  reservations               reservations @relation(fields: [reservation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                      users        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reservation_id])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// Durable deduplication of Stripe webhook deliveries. A row exists only when the event was processed and committed.
model stripe_webhook_events {
  id                 String   @id @db.VarChar(255)
  type               String   @db.VarChar(100)
  outcome            String   @db.VarChar(20)
  payment_attempt_id String?  @db.Uuid
  stripe_created_at  DateTime @db.Timestamptz(6)
  processed_at       DateTime @default(now()) @db.Timestamptz(6)
}
